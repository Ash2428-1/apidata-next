staging.apihub.xtend.co {
    # Serve the Xtend Hub v4 app (hosted on Vercel) under the staging domain
    reverse_proxy https://xtendapihub-v4.vercel.app {
        header_up Host {upstream_hostport}
        header_up X-Forwarded-Host {host}
    }
}

apihub.xtend.co {
    reverse_proxy app:3000
}

# Fallback for direct IP access
:80 {
    reverse_proxy app:3000
}
